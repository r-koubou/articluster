{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$ref": "#/definitions/Articulation",
  "definitions": {
    "Articulation": {
      "title": "Articulation",
      "type": "object",
      "description": "The root of articulation",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "format": "uuid"
        },
        "Author": {
          "type": "string"
        },
        "ManufacturerName": {
          "type": "string"
        },
        "ProductName": {
          "type": "string"
        },
        "PatchName": {
          "type": "string"
        },
        "Description": {
          "type": "string"
        },
        "Assignments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Assignment"
          }
        },
        "Extra": {
          "$ref": "#/definitions/Extra"
        }
      },
      "required": [
        "Id",
        "Author",
        "ManufacturerName",
        "ProductName",
        "PatchName",
        "Description",
        "Assignments",
        "Extra"
      ],
      "examples": [
        {
          "Id": "34023d3f-30b0-4646-90e8-5d2978d09d43",
          "Author": "r-koubou",
          "ManufacturerName": "r-koubou",
          "ProductName": "My Guitar",
          "PatchName": "My Guitar 1",
          "Description": "This is my guitar articulation.",
          "Assignments": [
            {
              "Name": "Sustain",
              "MidiMessages": [
                {
                  "Status": 144,
                  "Data1": 64,
                  "Data2": 100
                }
              ],
              "Extra": {
                "StudioOne.Color": "#FF0000"
              }
            },
            {
              "Name": "Bridge Mute",
              "MidiMessages": [
                {
                  "Status": 144,
                  "Data1": 66,
                  "Data2": 100
                }
              ],
              "Extra": {
                "StudioOne.Color": "#00FF00"
              }
            }
          ]
        }
      ]
    },
    "Assignment": {
      "title": "Assignment",
      "type": "object",
      "description": "An assignment within the articulation",
      "additionalProperties": false,
      "properties": {
        "Name": {
          "type": "string"
        },
        "MidiMessages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MidiMessage"
          }
        },
        "Extra": {
          "$ref": "#/definitions/Extra"
        }
      },
      "required": [
        "Name",
        "MidiMessages"
      ],
      "examples": [
        {
          "Name": "Sustain",
          "MidiMessages": [
            {
              "Status": 144,
              "Data1": 64,
              "Data2": 100
            }
          ],
          "Extra": {
            "StudioOne.Color": "#FF0000"
          }
        }
      ]
    },
    "MidiMessage": {
      "title": "MidiMessage",
      "type": "object",
      "description": "A MIDI message within the assignment",
      "additionalProperties": false,
      "properties": {
        "Status": {
          "type": "integer"
        },
        "Data1": {
          "type": "integer"
        },
        "Data2": {
          "type": "integer"
        }
      },
      "required": [
        "Status"
      ],
      "examples": [
        {
          "Status": 144,
          "Data1": 64,
          "Data2": 100
        }
      ]
    },
    "Extra": {
      "title": "Extra",
      "type": "object",
      "description": "Additional custom properties for the articulation and assignments",
      "additionalProperties": true,
      "examples": [
        { "Custom-Key": "Custom Value" }
      ]
    }
  }
}
